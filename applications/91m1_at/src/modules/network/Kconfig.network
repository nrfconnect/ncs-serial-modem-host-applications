menuconfig APP_NETWORK
	bool "Network module"
	default y
	depends on APP_MODEM_AT
	help
	  Configures the Serial Modem at start-up, brings LTE up and down with
	  AT+CFUN, and reports the LTE registration state from +CEREG over zbus.
	  The host runs no IP stack; the modem's own clients use the link.

if APP_NETWORK

config APP_NETWORK_THREAD_STACK_SIZE
	int "Thread stack size"
	default 2048

config APP_NETWORK_MODEM_READY_TIMEOUT_SECONDS
	int "Time to wait for the Serial Modem to answer at start-up (seconds)"
	default 30

config APP_NETWORK_WATCHDOG_TIMEOUT_SECONDS
	int "Watchdog timeout"
	default 300

config APP_NETWORK_MSG_PROCESSING_TIMEOUT_SECONDS
	int "Maximum message processing time"
	default 290

config APP_NETWORK_SEARCH_NETWORK_ON_STARTUP
	bool "Connect to network on startup"
	default y

module = APP_NETWORK
module-str = Network
source "subsys/logging/Kconfig.template.log_config"

endif
