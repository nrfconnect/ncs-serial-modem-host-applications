#include "nrf54l15_cpuapp_ns_partitions.dtsi"

/ {
	chosen {
		zephyr,console = &uart20;
		zephyr,shell-uart = &uart20;
		nordic,pm-ext-flash = &mx25r64;
	};
	aliases {
		modem = &modem;
		/delete-property/ sw3;
	};
};

/*
 * BUTTON3 is the only button on gpio0. The DK library adds one GPIO callback to
 * every port that has a button, and linking it into both port lists drops the
 * other gpio1 callbacks (Serial Modem RI).
 */
/delete-node/ &button3;

&uart30 {
	status = "okay";
	current-speed = <115200>;
	hw-flow-control;
	zephyr,pm-device-runtime-auto;

	modem: modem {
		compatible = "nordic,nrf91-sm-v2";
		status = "okay";
		mdm-reset-gpios = <&gpio1 10 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;
		mdm-ring-gpios = <&gpio1 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		mdm-dtr-gpios = <&gpio1 11 GPIO_ACTIVE_LOW>;
		zephyr,pm-device-runtime-auto;
		autostarts;
	};
};

&gpio1 {
	status = "okay";
};

/* Non-secure hardware watchdog, fallback for CONFIG_TASK_WDT_HW_FALLBACK. */
&wdt31 {
	status = "okay";
};
