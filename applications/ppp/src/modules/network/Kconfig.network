menuconfig APP_NETWORK
	bool "Network module"
	default y

if APP_NETWORK

config APP_NETWORK_THREAD_STACK_SIZE
	int "Thread stack size"
	default 2048

config APP_NETWORK_WATCHDOG_TIMEOUT_SECONDS
	int "Watchdog timeout"
	default 120
	help
	  Bringing the interface down blocks for up to 30 s in the modem_cellular
	  driver while it suspends the modem.
	  Must be greater than CONFIG_APP_NETWORK_MSG_PROCESSING_TIMEOUT_SECONDS.

config APP_NETWORK_MSG_PROCESSING_TIMEOUT_SECONDS
	int "Maximum message processing time"
	default 110
	help
	  Must exceed the 30 s the modem_cellular driver can block while suspending.
	  The value must be smaller than CONFIG_APP_NETWORK_WATCHDOG_TIMEOUT_SECONDS.

config APP_NETWORK_SEARCH_NETWORK_ON_STARTUP
	bool "Connect to network on startup"
	default y

module = APP_NETWORK
module-str = Network
source "subsys/logging/Kconfig.template.log_config"

endif
