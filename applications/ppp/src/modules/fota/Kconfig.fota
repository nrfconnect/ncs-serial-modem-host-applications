menuconfig APP_FOTA
	bool "FOTA"
	default y

if APP_FOTA

config APP_FOTA_SHELL
	bool "FOTA module shell commands"
	default y if SHELL
	help
	  Enable shell commands for the FOTA module.

config APP_FOTA_THREAD_STACK_SIZE
	int "Thread stack size"
	default 4096

config APP_FOTA_WATCHDOG_TIMEOUT_SECONDS
	int "Watchdog timeout"
	default 300
	help
	  Timeout for the FOTA module watchdog, covering both waiting for a message
	  and processing it. The download is callback driven, but the job poll makes
	  blocking CoAP calls, so the timeout matches the cloud module.
	  Must be greater than CONFIG_APP_FOTA_MSG_PROCESSING_TIMEOUT_SECONDS.

config APP_FOTA_MSG_PROCESSING_TIMEOUT_SECONDS
	int "Maximum message processing time"
	default 290
	help
	  Maximum time allowed for processing a single message in the module's state machine.
	  The value must be smaller than CONFIG_APP_FOTA_WATCHDOG_TIMEOUT_SECONDS.

module = APP_FOTA
module-str = FOTA
source "subsys/logging/Kconfig.template.log_config"

endif # APP_FOTA
