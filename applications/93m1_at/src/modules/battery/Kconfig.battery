menuconfig APP_BATTERY
	bool "Battery module"
	default y
	depends on APP_CLOUD && NRF_FUEL_GAUGE && NPM13XX_CHARGER
	help
	  Samples the nPM1300 fuel gauge and publishes state of charge to the cloud
	  module, which forwards it to nRF Cloud.

if APP_BATTERY

config APP_BATTERY_THREAD_STACK_SIZE
	int "Battery thread stack size (bytes)"
	default 2048

config APP_BATTERY_SAMPLE_INTERVAL
	int "Battery sampling interval (seconds)"
	default 60
	help
	  How often the fuel gauge is fed a new sample. Runs regardless of network
	  connectivity.

config APP_BATTERY_WATCHDOG_TIMEOUT_SECONDS
	int "Watchdog timeout"
	default 30

config APP_BATTERY_MSG_PROCESSING_TIMEOUT_SECONDS
	int "Maximum message processing time"
	default 10

module = APP_BATTERY
module-str = battery
source "subsys/logging/Kconfig.template.log_config"

endif # APP_BATTERY
