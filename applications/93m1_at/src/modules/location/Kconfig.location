menuconfig APP_LOCATION
	bool "Location module"
	default y
	depends on APP_MODEM_AT
	help
	  Requests an nRF Cloud location fix with AT%NRFCLOUDLOCATION. Driven by the
	  sync state machine in main.

if APP_LOCATION

config APP_LOCATION_THREAD_STACK_SIZE
	int "Location thread stack size (bytes)"
	default 1024

config APP_LOCATION_METHOD
	int "Location data collection method (1-7)"
	default 5
	range 1 7
	help
	  The AT%NRFCLOUDLOCATION method parameter. See the AT command reference for details.
	  The value is a bitmask of 1 = single-cell, 2 = multicell and 4 = Wi-Fi:
	  1: Single-cell only
	  2: Multicell only
	  3: Single-cell and multicell
	  4: Wi-Fi only
	  5: Wi-Fi and single-cell
	  6: Wi-Fi and multicell
	  7: Wi-Fi, single-cell and multicell

config APP_LOCATION_AT_TIMEOUT_SECONDS
	int "AT%NRFCLOUDLOCATION timeout (seconds)"
	default 60

config APP_LOCATION_WATCHDOG_TIMEOUT_SECONDS
	int "Watchdog timeout"
	default 150

config APP_LOCATION_MSG_PROCESSING_TIMEOUT_SECONDS
	int "Maximum message processing time"
	default 130
	help
	  modem_at_run() shares one AT pipe with other modules. This value must
	  exceed CONFIG_APP_MODEM_AT_PIPE_WAIT_TIMEOUT_SECONDS plus
	  CONFIG_APP_LOCATION_AT_TIMEOUT_SECONDS to cover that combined worst case.

module = APP_LOCATION
module-str = location
source "subsys/logging/Kconfig.template.log_config"

endif # APP_LOCATION
