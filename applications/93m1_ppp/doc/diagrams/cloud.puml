@startuml
' Source of truth for the Cloud module state machine in
' src/modules/cloud/cloud.c.
' Notation: /doc/architecture.md#state-diagram-notation
hide empty description

state STATE_INIT
STATE_INIT : entry / nrf_cloud_coap_init()

state STATE_DISCONNECTED

state STATE_CONNECTING
STATE_CONNECTING : entry / date_time_update_async() if !date_time_is_valid()
STATE_CONNECTING : entry / nrf_cloud_coap_connect() if date_time_is_valid()
STATE_CONNECTING : CLOUD_SYNC_REQUEST / pending = PENDING_DIAGNOSTICS
STATE_CONNECTING : LOCATION_SYNC_DONE / pending = PENDING_GROUND_FIX [CONFIG_APP_LOCATION]

state STATE_CONNECTED
STATE_CONNECTED : entry / upload_diagnostics(), publish CLOUD_SYNC_DONE if pending == PENDING_DIAGNOSTICS
STATE_CONNECTED : entry / ground_fix() if pending == PENDING_GROUND_FIX [CONFIG_APP_LOCATION]
STATE_CONNECTED : CLOUD_SYNC_REQUEST / upload_diagnostics(), publish CLOUD_SYNC_DONE
STATE_CONNECTED : LOCATION_SYNC_DONE / ground_fix() [CONFIG_APP_LOCATION]

[*] --> STATE_INIT
STATE_INIT --> STATE_DISCONNECTED

STATE_DISCONNECTED --> STATE_CONNECTING : CLOUD_SYNC_REQUEST / pending = PENDING_DIAGNOSTICS
STATE_DISCONNECTED --> STATE_CONNECTING : LOCATION_SYNC_DONE / pending = PENDING_GROUND_FIX [CONFIG_APP_LOCATION]

STATE_CONNECTING --> STATE_CONNECTING : CLOUD_PRIV_TIME_READY
STATE_CONNECTING --> STATE_CONNECTED : CLOUD_PRIV_SESSION_READY
STATE_CONNECTING --> STATE_DISCONNECTED : CLOUD_PRIV_TIME_NOT_OBTAINED || CLOUD_PRIV_SESSION_FAILED / publish CLOUD_SYNC_DONE if pending == PENDING_DIAGNOSTICS

STATE_CONNECTED --> STATE_DISCONNECTED : CLOUD_PRIV_SESSION_FAILED
@enduml
