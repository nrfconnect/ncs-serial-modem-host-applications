@startuml
' Source of truth for the FOTA module state machine in
' src/modules/fota/fota.c.
' Notation: /doc/architecture.md#state-diagram-notation
hide empty description

state STATE_RUNNING {
    state STATE_WAITING_FOR_POLL_REQUEST
    STATE_WAITING_FOR_POLL_REQUEST : FOTA_DOWNLOAD_CANCEL / ;

    state STATE_POLLING_FOR_UPDATE
    STATE_POLLING_FOR_UPDATE : entry / nrf_cloud_fota_poll_init(), nrf_cloud_fota_poll_process()
    STATE_POLLING_FOR_UPDATE : FOTA_DOWNLOAD_CANCEL / ;

    state STATE_DOWNLOADING_UPDATE
    STATE_DOWNLOADING_UPDATE : entry / publish FOTA_STARTING

    state STATE_AWAITING_NETWORK_DOWN_BEFORE_REBOOT
    STATE_AWAITING_NETWORK_DOWN_BEFORE_REBOOT : entry / publish FOTA_NETWORK_DISCONNECT_NEEDED
    STATE_AWAITING_NETWORK_DOWN_BEFORE_REBOOT : FOTA_DOWNLOAD_CANCEL / ;

    state STATE_REBOOT_PENDING
    STATE_REBOOT_PENDING : entry / publish FOTA_SUCCESS
    STATE_REBOOT_PENDING : FOTA_DOWNLOAD_CANCEL / ;

    state STATE_CANCELING
    STATE_CANCELING : entry / fota_download_cancel()

    [*] --> STATE_WAITING_FOR_POLL_REQUEST

    STATE_WAITING_FOR_POLL_REQUEST --> STATE_POLLING_FOR_UPDATE : FOTA_POLL_REQUEST

    STATE_POLLING_FOR_UPDATE --> STATE_DOWNLOADING_UPDATE : FOTA_PRIV_DOWNLOADING
    STATE_POLLING_FOR_UPDATE --> STATE_AWAITING_NETWORK_DOWN_BEFORE_REBOOT : FOTA_PRIV_REBOOT_NEEDED / publish FOTA_STARTING
    STATE_POLLING_FOR_UPDATE --> STATE_WAITING_FOR_POLL_REQUEST : FOTA_PRIV_ABORTED / publish FOTA_ABORTED

    STATE_DOWNLOADING_UPDATE --> STATE_AWAITING_NETWORK_DOWN_BEFORE_REBOOT : FOTA_PRIV_REBOOT_NEEDED
    STATE_DOWNLOADING_UPDATE --> STATE_WAITING_FOR_POLL_REQUEST : FOTA_PRIV_ABORTED / publish FOTA_ABORTED

    STATE_AWAITING_NETWORK_DOWN_BEFORE_REBOOT --> STATE_REBOOT_PENDING : FOTA_NETWORK_DISCONNECTED

    STATE_CANCELING --> STATE_WAITING_FOR_POLL_REQUEST : FOTA_PRIV_ABORTED / publish FOTA_ABORTED
}
STATE_RUNNING : entry / boot_write_img_confirmed() [CONFIG_MCUBOOT_IMG_MANAGER]
STATE_RUNNING : entry / publish FOTA_MODULE_READY

[*] --> STATE_RUNNING
STATE_RUNNING --> STATE_CANCELING : FOTA_DOWNLOAD_CANCEL
@enduml
