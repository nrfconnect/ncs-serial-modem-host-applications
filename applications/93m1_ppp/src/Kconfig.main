menu "Main"

config APP_MAIN_WATCHDOG_TIMEOUT_SECONDS
	int "Watchdog timeout"
	default 120

config APP_MAIN_MSG_PROCESSING_TIMEOUT_SECONDS
	int "Maximum message processing time"
	default 110

config APP_MAIN_SYNC_BOOT_DELAY_SECONDS
	int "Delay before the first sync after connect (seconds)"
	default 10
	help
	  Lets the CoAP session settle before the first location fix and
	  FOTA poll.

config APP_MAIN_SYNC_INTERVAL_SECONDS
	int "Cloud synchronization interval (seconds)"
	default 600
	help
	  Time between cloud synchronizations while the network is connected.
	  The first one runs APP_MAIN_SYNC_BOOT_DELAY_SECONDS after connect.
	  Each one:

	  - Posts pending Memfault data (CONFIG_APP_CLOUD only).
	  - Requests a location fix (CONFIG_APP_LOCATION only).
	  - Polls for a FOTA job (CONFIG_APP_FOTA only).

	  If no cloud session can be established, the location and FOTA
	  steps are skipped until the next synchronization.

module = APP_MAIN
module-str = Main
source "subsys/logging/Kconfig.template.log_config"

endmenu
