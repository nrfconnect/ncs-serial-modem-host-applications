menu "Main"

config APP_MAIN_WATCHDOG_TIMEOUT_SECONDS
	int "Watchdog timeout"
	default 30
	help
	  The module only publishes messages and schedules work in its handlers;
	  it never blocks. The timeout is kept short so a stuck thread is caught
	  quickly, while leaving ample margin over the message processing budget.

config APP_MAIN_MSG_PROCESSING_TIMEOUT_SECONDS
	int "Maximum message processing time"
	default 5

config APP_MAIN_SYNC_INTERVAL_SECONDS
	int "Cloud syncronization interval (seconds)"
	default 600
	help
	  Time between cloud synchronizations while connected to nRF Cloud.
	  A synchronization also runs immediately on connect. Each one:

	  - Sends the demo payload.
	  - Requests a location fix (location overlay only).
	  - Polls the device shadow.
	  - Polls for a FOTA job (CONFIG_APP_FOTA only).
	  - Posts pending Memfault data.

config APP_MAIN_CLOUD_SYNC_WORKQ_STACK_SIZE
	int "Cloud synchronization workqueue stack size"
	default 1024

config APP_MAIN_CLOUD_SYNC_WORKQ_PRIORITY
	int "Cloud synchronization workqueue priority"
	default 5

module = APP_MAIN
module-str = Main
source "subsys/logging/Kconfig.template.log_config"

endmenu
