@startuml
' SPDX-License-Identifier: LicenseRef-Nordic-5-Clause
' Cloud synchronization substates of STATE_CLOUD_CONNECTED in src/main.c.
' The top level of the same state machine is in main.puml.
' Notation: ../architecture.md#diagram-notation
!include style.puml

state STATE_CLOUD_CONNECTED #FFFFFF {
    state STATE_SYNC_IDLE
    STATE_SYNC_IDLE : entry / cloud_sync_schedule()

    state STATE_SYNC_DEMO
    STATE_SYNC_DEMO : entry / publish CLOUD_MESSAGE_SEND

    state STATE_SYNC_LOCATION #FFFFFF;line:94A3B8;line.dashed
    STATE_SYNC_LOCATION : <i>CONFIG_APP_LOCATION</i>
    STATE_SYNC_LOCATION : entry / publish LOCATION_SEARCH_TRIGGER

    state STATE_SYNC_SHADOW
    STATE_SYNC_SHADOW : entry / publish CLOUD_SHADOW_POLL_REQUEST

    state STATE_SYNC_FOTA #FFFFFF;line:94A3B8;line.dashed
    STATE_SYNC_FOTA : <i>CONFIG_APP_FOTA</i>
    STATE_SYNC_FOTA : entry / cloud_sync_cancel()
    STATE_SYNC_FOTA : entry / publish FOTA_POLL_REQUEST

    state STATE_SYNC_MEMFAULT
    STATE_SYNC_MEMFAULT : entry / publish CLOUD_MEMFAULT_POST_REQUEST

    [*] --> STATE_SYNC_DEMO

    STATE_SYNC_DEMO -[#94A3B8,dashed]-> STATE_SYNC_LOCATION : CLOUD_MESSAGE_SENT
    STATE_SYNC_LOCATION -[#94A3B8,dashed]-> STATE_SYNC_SHADOW : LOCATION_SEARCH_DONE
    STATE_SYNC_DEMO --> STATE_SYNC_SHADOW : CLOUD_MESSAGE_SENT\n[no location]

    STATE_SYNC_SHADOW -[#94A3B8,dashed]-> STATE_SYNC_FOTA : CLOUD_SHADOW_POLLED
    STATE_SYNC_FOTA -[#94A3B8,dashed]-> STATE_SYNC_MEMFAULT : FOTA_ABORTED
    STATE_SYNC_SHADOW --> STATE_SYNC_MEMFAULT : CLOUD_SHADOW_POLLED\n[no FOTA]

    STATE_SYNC_MEMFAULT --> STATE_SYNC_IDLE : CLOUD_MEMFAULT_POSTED
    STATE_SYNC_IDLE --> STATE_SYNC_DEMO : MAIN_PRIV_CLOUD_SYNCHRONIZATION
}

state STATE_FOTA #FFFFFF;line:94A3B8;line.dashed
STATE_FOTA : <i>see main.svg</i>
STATE_SYNC_FOTA -[#94A3B8,dashed]-> STATE_FOTA : FOTA_STARTING

legend bottom
  STATE_SYNC_IDLE is the declared initial substate, but the entry function of
  STATE_CLOUD_CONNECTED transitions straight to STATE_SYNC_DEMO, so connecting
  always synchronizes once without waiting out a period.
end legend

@enduml
